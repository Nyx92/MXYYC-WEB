// prisma/schema.prisma

// This block generates the Prisma Client (your typesafe database client, default location)
generator client {
  provider = "prisma-client-js"
}

// Datasource — two URLs are required because Supabase exposes two endpoints:
//
//   DATABASE_URL  → transaction-mode pooler (port 6543, pgbouncer=true)
//     Used at runtime by the Next.js app. Connections are released back to the
//     pool the moment a query finishes, so many API routes can share a small
//     number of real DB connections without hitting Supabase’s 15-connection
//     session-mode ceiling.  Prepared statements are disabled (pgbouncer=true)
//     because PgBouncer in transaction mode does not support them.
//
//   DIRECT_URL    → direct Postgres connection (port 5432, no pooler)
//     Used only by Prisma CLI commands (prisma migrate, prisma db push,
//     prisma studio).  These commands need a persistent session — something
//     transaction-mode pooling cannot provide — so they bypass the pooler
//     entirely and talk to Postgres directly.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Main user table.
// NextAuth requires `id`, `email`, `name`, `image`, etc.
// We added `password` so you can later support credentials-based login.
// Relations: a user can have multiple accounts (e.g., Google, GitHub) and sessions.
model User {
  id            String    @id @default(cuid())
  // Standard NextAuth fields — required by PrismaAdapter for OAuth providers.
  name          String?
  image         String?
  firstName     String?
  lastName      String?
  username      String?   @unique
  email         String    @unique
  password      String?
  // Forgot-password flow: a random raw token is emailed to the user, and
  // only its SHA-256 hash is stored here — same principle as never storing
  // a plaintext password, so a DB leak alone can't be used to reset accounts.
  passwordResetTokenHash      String?
  passwordResetTokenExpiresAt DateTime?
  role          String    @default("user")
  emailVerified DateTime?
  verified      Boolean   @default(false)
  // Purchase-gate flag: whether phoneNumber has completed OTP verification.
  // Kept separate from `verified` above, which is a legacy "trusted signup"
  // flag (e.g. auto-set true for Google OAuth users) unrelated to phone
  // ownership — see AccountLayout/ProfileContent for how the two are shown.
  phoneVerified Boolean   @default(false)
  // Email/phone OTP verification: a random 6-digit code is sent to the
  // user, and only its SHA-256 hash + expiry are stored here — same
  // principle as passwordResetTokenHash above. attempts tracks wrong guesses
  // against the current code so a fixed number of tries locks it out,
  // instead of letting the 15-min rate-limit window be the only thing
  // standing between an attacker and brute-forcing a 6-digit (1e6) space.
  emailVerificationCodeHash      String?
  emailVerificationCodeExpiresAt DateTime?
  emailVerificationAttempts      Int       @default(0)
  phoneVerificationCodeHash      String?
  phoneVerificationCodeExpiresAt DateTime?
  phoneVerificationAttempts      Int       @default(0)
  country       String?
  sex           String?
  dob           DateTime? @db.Date
  address       String?
  phoneNumber   String?

  // 🔗  Relations
  accounts           Account[]
  sessions           Session[]
  // A user can own multiple cards, make offers, send messages, and participate in conversations.
  listings           Listing[]
  offers             Offer[]           @relation("UserOffers")
  receivedOffers     Offer[]           @relation("OffersReceived")
  sellerOrders       Order[]           @relation("SellerOrders")
  buyerOrders        Order[]           @relation("BuyerOrders")
  reservedListings   Listing[]         @relation("CardReservations")
  sellerTransactions CardTransaction[] @relation("SellerTransactions")
  buyerTransactions  CardTransaction[] @relation("BuyerTransactions")
  watchlist          CardWatchlist[]
  cart               Cart?
  notifications      Notification[]
  auctions           Auction[]         @relation("SellerAuctions")
  bids               Bid[]             @relation("UserBids")
  highestBidAuctions Auction[]         @relation("AuctionHighestBidder")
  collectionRequests CollectionRequest[]
  collectionHandovers CollectionRequest[] @relation("CollectionHandovers")
}

// Stores provider account details (e.g. Google, GitHub, etc.)
// Links back to User via userId
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Stores active sessions
// Each login creates a session with an expiry time
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // Relation back to User
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// For email login flows (magic links, passwordless login, etc.)
// Stores one-time-use tokens
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

//////////////////////////////////////////////////////////////
// 🧩 Custom Models for Pokémon Marketplace & Inventory System
//////////////////////////////////////////////////////////////

// One row per real, canonical Pokémon card — shared by every seller who
// lists that card. This is "what card is this," not "this seller's copy of
// it" (that's Listing, below). externalId is required+unique but has no
// real source data yet — seed data uses invented "mock-*" slugs until a
// real card-index import exists.
model PokemonCardCatalog {
  id             String    @id @default(uuid())
  externalId     String    @unique // stable id from the source card index, e.g. "sv3pt5-016"
  nameEn         String
  nameJa         String?
  hp             Int?
  stage          String?
  types          String[]
  dexIds         Int[]
  illustrator    String?
  isFirstEdition Boolean   @default(false)
  // Print-language classification; carried through as-is from the source
  // index alongside the separate nameEn/nameJa fields.
  language       String
  regulationMark String?
  localId        String? // card number within its set, e.g. "016" or "SV107"
  printedNumber  String? // as printed on the card, e.g. "001/073" or "2/102" (tcg-index-sync)
  setId          String
  setNameEn      String
  setNameJa      String?
  setReleaseDate DateTime?
  setTotal       Int?
  rarity         String
  year           Int?
  tcgPlayerId    String?   @unique
  // Canonical card image (e.g. from tcgdex.dev), populated by the card
  // lookup import pipeline. Nullable — unlike Riftbound's imageUrl (which
  // predates this field and defaults to a required blank string), this is
  // new, so existing rows simply have no image until the next import.
  imageUrl       String?
  listings       Listing[]
  priceHistory   PriceHistory[]
  // Set once GET /api/cron/backfill-prices has pulled this card's full year
  // of history from JustTCG. Null means "never backfilled" — that's the
  // resumable job's queue, so a card is only ever deep-pulled once, not
  // re-pulled on every backfill run.
  priceBackfilledAt DateTime?
  // Failed backfill attempts. The job pulls the fewest-failed cards first
  // and drops a card from the queue after MAX_BACKFILL_ATTEMPTS, so a card
  // JustTCG can never price stops burning the daily request budget and can't
  // block the queue. Reset to 0 to retry it.
  priceBackfillAttempts Int @default(0)
  // Last time refresh-prices fetched today's price for this card (listed
  // cards daily, every other card weekly). Null = never refreshed; the job
  // picks the oldest first.
  priceRefreshedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([setId])
  // refresh-prices: oldest-refreshed first. backfill-prices: queue of
  // not-yet-backfilled cards, fewest failures first.
  @@index([priceRefreshedAt])
  @@index([priceBackfilledAt, priceBackfillAttempts])
}

// One row per real, canonical Riftbound card. Same role as
// PokemonCardCatalog above, for the other game.
model RiftboundCardCatalog {
  id              String    @id @default(uuid())
  riftboundId     String    @unique // e.g. "unl-176-219" — set + collector number + set total
  name            String
  type            String // e.g. "Unit"
  supertype       String // e.g. "Champion"
  rarity          String
  domain          String[] // some cards carry two domains (e.g. dual-domain gold cards)
  energy          Int?
  might           Int?
  power           Int?
  artist          String?
  alternateArt    Boolean   @default(false)
  signature       Boolean   @default(false)
  overnumbered    Boolean   @default(false)
  tags            String[]
  textFlavour     String?
  textPlain       String?
  setId           String
  setLabel        String
  collectorNumber String // string, not Int — overnumbered variants carry a suffix
  printedNumber   String? // as printed on the card, e.g. "002/219" (tcg-index-sync)
  imageUrl        String
  tcgPlayerId     String?   @unique
  listings        Listing[]
  priceHistory    PriceHistory[]
  // See PokemonCardCatalog.priceBackfilledAt / priceBackfillAttempts above.
  priceBackfilledAt DateTime?
  priceBackfillAttempts Int @default(0)
  priceRefreshedAt DateTime? // see PokemonCardCatalog.priceRefreshedAt
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([setId])
  @@index([priceRefreshedAt])
  @@index([priceBackfilledAt, priceBackfillAttempts])
}

// 🃏 Listing — one seller's specific physical copy of a card, listed for
// sale. Renamed from Card. Exactly one of pokemonCardId/riftboundCardId is
// set, matching `game` — enforced by assertValidListingCatalogRefs() in
// src/lib/listingCatalog.ts (Task 3), not a database CHECK constraint,
// since this project has no migration history to hand-write one into.
model Listing {
  id   String @id @default(uuid())
  game String // "POKEMON" | "RIFTBOUND"

  pokemonCard     PokemonCardCatalog?   @relation(fields: [pokemonCardId], references: [id], onDelete: Restrict)
  pokemonCardId   String?
  riftboundCard   RiftboundCardCatalog? @relation(fields: [riftboundCardId], references: [id], onDelete: Restrict)
  riftboundCardId String?

  price       Int?
  condition   String
  description String?
  imageUrls   String[] // URLs to Supabase Storage images — photos of this specific physical copy
  forSale     Boolean  @default(false)

  // Reservation fields — used by the Buy Now Stripe Checkout flow to prevent
  // double-selling while the buyer is on Stripe's hosted payment page.
  // When a buyer starts checkout, the listing is locked for a short window
  // (reservedUntil). On payment success the lock is cleared and ownership transfers.
  reservedBy                User?     @relation("CardReservations", fields: [reservedById], references: [id], onDelete: SetNull)
  reservedById              String?
  reservedUntil             DateTime?
  // Multiple listings can share the same session ID (cart checkout).
  reservedCheckoutSessionId String?

  // Relations
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  ownerId      String
  offers       Offer[]
  transactions CardTransaction[]
  orders       Order[]
  watchlist    CardWatchlist[]
  cartItems    CartItem[]
  // Auction listings for this card (multiple allowed over time — one active at a time,
  // enforced at the application layer via Listing.inAuction).
  inAuction    Boolean           @default(false)
  auctions     Auction[]

  // In-person collection: set while this card is earmarked for pickup at the
  // physical shop (mutually exclusive with forSale/inAuction at the
  // application layer — see the guards in POST /api/auctions,
  // PUT /api/cards/[id], and POST /api/collection-requests). Kept on the
  // listing (not cleared) after collection so it stays linked to its
  // CollectionRequest for history — collectedAt is what actually hides it
  // from "My Collection" (see GET /api/user/cards), same "never delete,
  // just flag" pattern the sold/auction-settlement paths already use.
  collectionRequest   CollectionRequest? @relation(fields: [collectionRequestId], references: [id], onDelete: SetNull)
  collectionRequestId String?
  collectedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  // Marketplace: for-sale listings, newest first (GET /api/cards pagination).
  @@index([forSale, createdAt(sort: Desc)])
  // Stripe webhook / checkout expiry look listings up by checkout session.
  @@index([reservedCheckoutSessionId])
  @@index([game])
  @@index([pokemonCardId])
  @@index([riftboundCardId])
  @@index([collectionRequestId])
}

// 📈 PriceHistory — one external market-price snapshot for a card, for one
// day, for one variant ("RAW" for ungraded, or a grade label like "PSA 10").
// Sourced from JustTCG (src/lib/pricing/justtcg.ts) by the daily cron job at
// GET /api/cron/refresh-prices — never written to on a page view.
//
// Exactly one of pokemonCardId/riftboundCardId is set, matching `game` — same
// convention as Listing above. For the same reason Listing has no DB
// CHECK constraint for that rule, this model has no DB-level unique
// constraint on (card, variant, capturedAt) either: Postgres does not treat
// two NULLs as equal, so a compound unique index across both nullable FK
// columns would not reject duplicate Riftbound rows. The refresh job
// enforces "one row per card+variant+day" itself with a find-then-write.
model PriceHistory {
  id   String @id @default(uuid())
  game String // "POKEMON" | "RIFTBOUND"

  // Restrict: deleting a catalog card must never delete its price history.
  pokemonCard     PokemonCardCatalog?   @relation(fields: [pokemonCardId], references: [id], onDelete: Restrict)
  pokemonCardId   String?
  riftboundCard   RiftboundCardCatalog? @relation(fields: [riftboundCardId], references: [id], onDelete: Restrict)
  riftboundCardId String?

  variant    String // "RAW" | "PSA 10" | "CGC 9.5" | ... — see toPriceVariantLabel()
  priceCents Int // SGD, converted from JustTCG's USD price when the row is written
  capturedAt DateTime @db.Date // the day this snapshot is for (no time component)

  createdAt DateTime @default(now())

  // Charts and the price jobs read one card's rows for a variant over a date
  // range; capturedAt last so the same index serves range scans.
  @@index([game, pokemonCardId, variant, capturedAt])
  @@index([game, riftboundCardId, variant, capturedAt])
  // Daily price report: rows written / captured in the last day or week.
  @@index([createdAt])
  @@index([capturedAt])
}

// 📦 CollectionRequest — a customer's request to pick up one or more owned
// cards in person from the physical shop, instead of shipping (shipping is
// a future feature). Groups cards via the nullable Listing.collectionRequestId
// FK (no join table needed — a card belongs to at most one open request).
//
// Lifecycle: REQUESTED (customer asked to pick up) → PACKED (staff has
// physically pulled and bagged the cards — see POST
// /api/collection-requests/[id]/mark-packed) → COLLECTED (customer verified
// their identity in-store via a one-time code and the cards were handed
// over — see POST /api/collection-requests/[id]/otp/confirm).
//
// A customer can keep adding more ready-to-collect cards to their own open
// (REQUESTED or PACKED) request rather than creating a new one each time —
// topping up a PACKED request reverts it to REQUESTED so staff re-packs
// with the new items included.
model CollectionRequest {
  id        String @id @default(cuid())
  // Human-readable reference shown to the customer and in the Discord
  // staff alert, e.g. "PU-2609-A1B2" — easier to say/write than a cuid.
  requestRef String @unique

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String

  status String @default("REQUESTED") // REQUESTED | PACKED | COLLECTED

  requestedAt DateTime  @default(now())
  packedAt    DateTime?
  collectedAt DateTime?

  // One Discord message per "top up" alert (a customer can add items to an
  // already-alerted request) — all of them get edited to a resolved state
  // together when staff mark the request packed. Silent no-op if
  // DISCORD_WEBHOOK_URL isn't configured — see src/lib/discord.ts.
  discordMessageIds String[]

  // Pickup verification code: the customer requests a code (sent to their
  // already-phone-verified number) and enters it themselves in-app to
  // confirm their own identity before the cards are released — same
  // hash-only-storage + attempt-lockout principle as
  // User.emailVerificationCodeHash / phoneVerificationCodeHash (see
  // src/lib/verificationCode.ts), reused here rather than duplicated.
  pickupCodeHash      String?
  pickupCodeExpiresAt DateTime?
  pickupCodeAttempts  Int       @default(0)

  // Staff attestation: which admin confirmed they physically handed the
  // cards over. Set by a separate, optional admin action — never by the
  // customer's own OTP confirm, which has no staff session in it at all
  // (that route requires the caller to *be* the customer). Null until a
  // staff member attributes the handover to themselves; never required
  // to reach COLLECTED.
  collectedByStaff   User?   @relation("CollectionHandovers", fields: [collectedByStaffId], references: [id], onDelete: SetNull)
  collectedByStaffId String?

  listings Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Order {
  id        String  @id @default(uuid())
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  listingId String

  seller   User   @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  sellerId String
  buyer    User   @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  buyerId  String

  amount   Int // store cents
  currency String @default("sgd")
  status   String @default("PENDING") // PENDING | PAID | EXPIRED | CANCELED | REFUNDED

  // Multiple orders can share the same session ID (cart checkout).
  stripeCheckoutSessionId String?
  // Multiple orders in a cart share one payment intent; uniqueness enforced by Stripe itself.
  stripePaymentIntentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions CardTransaction[]
  offer        Offer?

  @@index([stripeCheckoutSessionId])
  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
}

// 💸 Offer — represents an offer made by a buyer on a card
model Offer {
  id      String  @id @default(uuid())
  price   Int?
  message String?
  // Lifecycle: pending → accepted → paid  (happy path)
  //            pending → rejected         (seller declines)
  //            pending → expired          (no seller response within 24h; PI cancelled by cron)
  status  String  @default("pending")

  // Set when the listing changes ownership (sold). New owner won't see archived offers,
  // but the historical record is preserved for buyers and admins.
  archivedAt DateTime?

  // Stripe PaymentIntent ID for the authorised-but-not-captured charge.
  // Created when the buyer submits the offer form (capture_method: manual).
  // Captured on accept, cancelled on reject/expiry.
  // @unique: one PI backs at most one offer (DB-level guard behind the route's
  // reuse check, which can't close a simultaneous-request race on its own).
  paymentIntentId String? @unique

  // When this pending offer expires (24h from creation).
  // After this point the cron job will cancel the PI and mark status → "expired".
  expiresAt DateTime?

  // Relations
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  listingId String
  buyer     User    @relation("UserOffers", fields: [buyerId], references: [id], onDelete: Restrict)
  buyerId   String
  // Snapshot of who the seller was at offer-creation time.
  // listing.ownerId changes when the listing is transferred, so we can't rely on it
  // to look up a seller's offer history after an accepted sale.
  seller    User    @relation("OffersReceived", fields: [sellerId], references: [id], onDelete: Restrict)
  sellerId  String

  // Linked to an Order when the accepted offer is paid
  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  // expire-offers cron: pending offers past expiresAt; accepted offers stuck
  // since updatedAt.
  @@index([status, expiresAt])
  @@index([status, updatedAt])
  @@index([buyerId])
  @@index([sellerId])
}

// 🌟 Admin-curated best sellers (by card type, not individual listing)
model BestSeller {
  id          String   @id @default(uuid())
  tcgPlayerId String   @unique // maps to a catalog row's tcgPlayerId (PokemonCardCatalog or RiftboundCardCatalog) — loose string match, not a real relation; see spec's "Out of scope" section
  position    Int      @unique // display order 1–5
  createdAt   DateTime @default(now())
}

// 🔖 CardWatchlist — tracks which users have watchlisted which cards
model CardWatchlist {
  id        String   @id @default(uuid())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([listingId, userId])
  @@index([userId]) // GET /api/watchlist lists one user's entries
}

// 🛒 Cart — one persistent cart per user; created lazily on first add
model Cart {
  id        String     @id @default(uuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// 🛒 CartItem — a single card added to a user's cart
model CartItem {
  id        String   @id @default(uuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  // Whether this item is checked for checkout (user can uncheck individual items)
  selected  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([cartId, listingId])
}

// 🔔 Notification — in-app + email alerts for offer and sale events
model Notification {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Notification category — drives the icon and email copy.
  // Values: "offer_received" | "offer_accepted" | "offer_rejected" | "card_sold"
  type  String
  title String
  body  String

  // Optional IDs for deep-linking into the relevant page.
  // Stored as plain strings (no FK) so the notification survives if the
  // linked record is later deleted.
  offerId   String?
  listingId String?
  orderId   String?

  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  // Unread count — polled every 5 s per open notification stream.
  @@index([userId, read])
}

model CardTransaction {
  id String @id @default(uuid())

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  listingId String

  seller   User   @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: Restrict)
  sellerId String

  buyer   User   @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Restrict)
  buyerId String

  amount        Int
  currency      String
  // One Stripe event can cover multiple orders (cart checkout).
  stripeEventId String
  tcgPlayerId   String?

  createdAt DateTime @default(now())

  // Composite: one stripe event may produce multiple transactions (one per order in cart checkout).
  @@unique([stripeEventId, orderId])
  @@index([buyerId])
  @@index([listingId])
  @@index([sellerId])
}

// 🔨 Auction — a timed listing where buyers compete with binding bids.
//
// Lifecycle:
//   active → sold                  (a bid hits RP/BO, or cron auto-settles when endsAt passes with bid >= RP)
//   active → pending_seller_decision  (endsAt passed, bid exists but below RP — seller gets 1 day)
//   active → expired               (endsAt passed, no bids placed)
//   pending_seller_decision → sold    (seller accepts within the deadline)
//   pending_seller_decision → expired (seller declines or deadline passes)
//
// One active auction per listing is enforced at the application layer (Listing.inAuction flag).
// Historical auction rows are kept for audit/display after the listing is sold.
model Auction {
  id        String  @id @default(uuid())
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  listingId String
  seller    User    @relation("SellerAuctions", fields: [sellerId], references: [id], onDelete: Restrict)
  sellerId  String

  startingBid  Int // minimum first bid (cents)
  reservePrice Int? // auto-accept floor checked at endsAt: if final bid >= RP the cron settles without seller action; does NOT end the auction early during bidding
  buyOutPrice  Int? // instant-purchase price: bid >= BO ends the auction immediately during bidding

  currentBid      Int? // current highest bid amount (cents); null = no bids yet
  highestBidder   User?   @relation("AuctionHighestBidder", fields: [highestBidderId], references: [id], onDelete: SetNull)
  highestBidderId String?

  // active | pending_seller_decision | sold | expired
  status String @default("active")

  endsAt                 DateTime // when the auction closes (1–5 days from creation; see src/constants/auctions.ts)
  sellerDecisionDeadline DateTime? // set when → pending_seller_decision (+24h); null otherwise

  // Optimistic lock counter: every bid increments this.
  // Concurrent bid requests use updateMany WHERE version = snapshot to ensure
  // only one bid wins the write; the loser gets a 409 and retries.
  version Int @default(0)

  bids Bid[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, endsAt])
  // expire-auctions pass 2: pending decisions past their deadline.
  @@index([status, sellerDecisionDeadline])
  // Card pages and auction create look auctions up by listing.
  @@index([listingId])
  @@index([sellerId])
}

// 💵 Bid — a single binding bid placed by a buyer in an auction.
//
// Each bid holds a Stripe PaymentIntent (capture_method: "manual").
// Funds are authorised (held) on the buyer's card but not charged until
// the auction settles.
//
// Status values:
//   active    — current highest bid; PI hold is live
//   won       — this bid won the auction; PI was captured
//   cancelled — outbid or auction ended without a win; PI was cancelled
model Bid {
  id        String  @id @default(uuid())
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  auctionId String
  bidder    User    @relation("UserBids", fields: [bidderId], references: [id], onDelete: Restrict)
  bidderId  String

  amount          Int // bid amount in cents
  // Stripe PI with capture_method: "manual". @unique: one PI backs at most
  // one bid (DB-level guard behind the bid route's reuse check).
  paymentIntentId String @unique

  // active | won | cancelled
  status String @default("active")

  createdAt DateTime @default(now())

  @@index([auctionId, status])
  @@index([bidderId])
}

// One row per background job (e.g. "refresh-prices", "backfill-prices"), plus
// "justtcg-quota" for the latest JustTCG quota numbers. Lets a job alert only
// when its status changes (ok → failing, failing → ok) instead of on every
// run, and lets the daily price report see when each job last ran.
model JobState {
  job         String   @id
  lastRunAt   DateTime
  lastOk      Boolean
  lastSummary String
  data        Json?
  updatedAt   DateTime @updatedAt
}

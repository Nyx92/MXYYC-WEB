{
  "name": "mxyyc-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "preinstall": "only-allow pnpm",
    "postinstall": "prisma generate",
    "dev": "concurrently --kill-others --names \"next,stripe\" --prefix-colors \"cyan,yellow\" \"next dev --turbopack -p 3000\" \"bash script/dev-stripe-listen.sh\"",
    "dev:next": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "tsx prisma/seed.ts",
    "seed:riftbound-listings": "tsx prisma/seedRiftboundListings.ts",
    "import:catalog-delta": "tsx prisma/importCatalogDelta.ts",
    "reset-db": "bash script/reset-db.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli"
    ]
  },
  "dependencies": {
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@mui/system": "^7.3.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.16.2",
    "@sentry/nextjs": "^10.75.0",
    "@stripe/react-stripe-js": "^6",
    "@stripe/stripe-js": "^9.0.1",
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^3.0.2",
    "country-list": "^2.4.1",
    "framer-motion": "^12.40.0",
    "fuse.js": "^7.1.0",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-phone-input-2": "^2.15.1",
    "recharts": "^3.6.0",
    "resend": "^6.12.3",
    "sharp": "^0.35.4",
    "stripe": "^17.5.0",
    "swiper": "^12.1.2",
    "twilio": "^6.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.2",
    "@types/country-list": "^2.1.4",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "concurrently": "^9.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdom": "^30.0.1",
    "only-allow": "^1.2.1",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^2.0.0"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
